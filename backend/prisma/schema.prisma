generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        Int           @id @default(autoincrement())
  name      String
  category  String
  price     Float
  stock     Int           @default(0)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  items     CommandItem[]
}

model Sale {
  id        Int      @id @default(autoincrement())
  product   String
  quantity  Int
  total     Float
  createdAt DateTime @default(now())
}

model User {
  id                     Int                     @id @default(autoincrement())
  name                   String
  email                  String                  @unique
  password               String
  mustChangePassword     Boolean                 @default(false)
  role                   Role
  createdAt              DateTime                @default(now())
  closedCommands         Command[]               @relation("ClosedCommands")
  openedCommands         Command[]               @relation("OpenedCommands")
  addedItems             CommandItem[]           @relation("AddedItems")
  auditLogs              AuditLog[]
  resolvedPasswordResets PasswordResetRequest[]
}

model Command {
  id             Int           @id @default(autoincrement())
  customer       String
  total          Float         @default(0)
  createdAt      DateTime      @default(now())
  closed         Boolean       @default(false)
  closedAt       DateTime?
  publicCode     String        @unique
  openedByUserId Int?
  closedByUserId Int?
  closedBy       User?         @relation("ClosedCommands", fields: [closedByUserId], references: [id])
  openedBy       User?         @relation("OpenedCommands", fields: [openedByUserId], references: [id])
  items          CommandItem[]
  auditLogs      AuditLog[]
}

model CommandItem {
  id            Int      @id @default(autoincrement())
  quantity      Int
  createdAt     DateTime @default(now())
  commandId     Int
  productId     Int
  addedByUserId Int?
  paid          Boolean  @default(false)
  addedBy       User?    @relation("AddedItems", fields: [addedByUserId], references: [id])
  command       Command  @relation(fields: [commandId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])
}

enum Role {
  ADMIN
  MINIMERCADO
  SECRETARIA
}

// Registro de auditoria — toda alteração relevante feita no sistema
// (item adicionado/removido, comanda aberta/renomeada/fechada, pagamento).
model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String
  createdAt DateTime @default(now())
  userId    Int?
  commandId Int?
  user      User?    @relation(fields: [userId], references: [id])
  command   Command? @relation(fields: [commandId], references: [id])

  @@index([userId])
  @@index([commandId])
  @@index([action])
  @@index([createdAt])
}

// Pedido de "esqueci a senha" — sem envio de e-mail. Fica pendente até um
// ADMIN ver na tela de Usuários e redefinir a senha manualmente.
model PasswordResetRequest {
  id               Int       @id @default(autoincrement())
  email            String
  status           String    @default("PENDING") // PENDING | RESOLVED
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?
  resolvedByUserId Int?
  resolvedBy       User?     @relation(fields: [resolvedByUserId], references: [id])

  @@index([status])
  @@index([email])
}